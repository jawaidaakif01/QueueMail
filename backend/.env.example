PORT=5000
DATABASE_URL="postgresql://admin:password@localhost:5432/scheduler_db?schema=public"
REDIS_HOST="localhost"
REDIS_PORT=6379
ELASTICSEARCH_URL="http://localhost:9200"

# Ethereal Email Credentials (you can generate new ones on ethereal.email)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your_ethereal_user@ethereal.email"
SMTP_PASS="your_ethereal_password"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
JWT_SECRET="your_jwt_secret_key"

# Slack OAuth (if you want to implement full OAuth flow, else just use a webhook directly for testing)
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_WEBHOOK_URL=""

# Rate Limiting
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_BETWEEN_EMAILS_MS=2000
